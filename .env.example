# =============================================================================
# VoltarisOS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# The .env file is gitignored and should NEVER be committed.
# =============================================================================

# ─── Security (REQUIRED) ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Initial admin password (used only on first boot).
# If not set, a random password is generated and printed to stderr.
ADMIN_INITIAL_PASSWORD=

# Beta registration code (required for user self-registration)
BETA_CODE=

# Gateway API key (for the alert rules engine service-to-service auth)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

# Tenant-scoped gateway API keys (for telemetry ingestion).
# JSON mapping of gateway token -> tenant_id. Each token may only write
# telemetry to devices belonging to its own tenant.
# Example: GATEWAY_API_KEYS={"key-for-tenant-1":"1","key-for-tenant-2":"2"}
GATEWAY_API_KEYS={}

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
# SQLite (local dev): sqlite:///./voltaris.db
DATABASE_URL=sqlite:///./voltaris.db

# ─── Stripe (REQUIRED for payments) ──────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook secret (get from: https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=

# ─── Redis (OPTIONAL — for sessions/cache) ───────────────────────────────────
# If not set, falls back to in-memory cache
# Redis URL: redis://localhost:6379/0 or redis://user:password@host:6379/0
REDIS_URL=

# ─── 2FA / TOTP (OPTIONAL) ──────────────────────────────────────────────────
# Issuer name shown in authenticator app (default: VoltarisOS)
TOTP_ISSUER=VoltarisOS

# Enable/disable 2FA feature globally (default: false)
TOTP_ENABLED=false

# ─── API Keys (optional) ────────────────────────────────────────────────────
# OpenAI API key (for AI copilot features)
OPENAI_API_KEY=

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" in production environments
ENVIRONMENT=development

# ─── CORS (optional) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Default: http://localhost:3000,http://localhost:4200,https://voltarisos.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:4200,https://voltarisos.com

# ─── Token Expiry (optional) ────────────────────────────────────────────────
# JWT access token expiry in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Celery (optional — for async task processing) ──────────────────────────
# Celery broker URL (uses Redis if set, otherwise Redis URL is used)
# Example: redis://localhost:6379/0
CELERY_BROKER_URL=

# Celery result backend
# Example: redis://localhost:6379/1
CELERY_RESULT_BACKEND=

# ─── TimescaleDB (optional — for time-series data) ──────────────────────────
# TimescaleDB is a PostgreSQL extension for time-series data
# If not set, uses standard PostgreSQL/SQLite
# Example: postgresql://user:password@host:5432/timescaledb
TIMESCALEDB_URL=

# ─── Energy Market APIs (optional — for real-time prices) ───────────────────
# ENTSO-E Transparency Platform API key
# Get from: https://transparency.entsoe.eu/
ENTSOE_API_KEY=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api

# EEX (European Energy Exchange) API key
# Get from: https://www.eex.com/data
EEX_API_KEY=
EEX_BASE_URL=https://www.eex.com/data

# Market configuration
DEFAULT_MARKET=MIBEL
PRICE_UPDATE_INTERVAL_MINUTES=15

# ─── Stripe Metered Billing (optional) ──────────────────────────────────────
# Stripe metered price ID for usage-based billing
# Create at: https://dashboard.stripe.com/products
STRIPE_METERED_PRICE_ID=

# Enable/disable billing (default: true)
BILLING_ENABLED=true

# ─── Outbound destinations (SSRF guard, backend/netguard.py) ─────────────────
# By default the server refuses to connect to private/loopback addresses in
# production (device connection tests, EV charger Modbus, webhook delivery);
# cloud metadata addresses (169.254.x) are always refused. Set to "true" ONLY for
# a single-tenant on-prem install that talks to equipment on its own LAN.
# Unset: allowed in development, blocked when ENVIRONMENT=production.
ALLOW_PRIVATE_DESTINATIONS=

# ─── Data retention (backend/retention.py) ───────────────────────────────────
# A daily Celery task (RUN_CELERY=1) or `python -m backend.retention` prunes the
# tables that grow forever. Raw telemetry is summarised into hourly rows BEFORE it
# is deleted. Days per dataset; 0 = keep forever; values below the safe minimum
# are raised to it. Defaults shown. Try first with RETENTION_DRY_RUN=true.
# RETENTION_ENABLED=true
# RETENTION_DRY_RUN=false
# RETENTION_DEVICE_READINGS_DAYS=90     # min 35 (the load forecast reads 28 days)
# RETENTION_AUDIT_LOGS_DAYS=730
# RETENTION_ALERTS_DAYS=180             # acknowledged alerts only
# RETENTION_FORECAST_RECORDS_DAYS=60
# RETENTION_VPP_RUNS_DAYS=180           # VPP bids are never deleted
# RETENTION_REPORT_JOBS_DAYS=90         # rows and the PDF files
# RETENTION_STRIPE_EVENTS_DAYS=90
# RETENTION_LEADS_DAYS=365

