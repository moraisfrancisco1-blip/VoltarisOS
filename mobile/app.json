{
  "expo": {
    "name": "VoltarisOS",
    "slug": "voltaris-os",
    "owner": "voltarisos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voltarisos_k4x2.runable"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.voltarisos_k4x2.runable"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://voltarisos-production.up.railway.app",
      "eas": {
        "projectId": "d1374115-d221-4a74-8e04-cd729b2f339a"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-background-task",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#0a0f1a"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Savings",
              "label": "VoltarisOS -- Poupanca",
              "description": "Solar, bateria e poupanca de hoje em tempo real.",
              "minWidth": "220dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
